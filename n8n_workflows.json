tronic\",\"battery\",\"adapter\",\"mouse\",\"keyboard\",\"head mount\"],\n  food_snacks:   [\"ice cream\",\"icecream\",\"chocolate\",\"snack\",\"chips\",\"coke\",\"cola\",\"coca cola\",\"beverage\",\"juice\",\"maggi\"],\n  household:     [\"detergent\",\"cleaner\",\"mop\",\"utensil\",\"kitchen\",\"household\",\"tissue\"],\n  // --- concerns / problems ---\n  fees:          [\"delivery charge\",\"handling fee\",\"hidden charge\",\"hidden fee\",\"small cart\",\"extra charge\",\"charges are\"],\n  price:         [\"expensive\",\"costly\",\"price is high\",\"overpriced\",\"too high\",\"costlier\"],\n  refund_return: [\"refund\",\"return\",\"money back\",\"replace\",\"replacement\"],\n  quality:       [\"rotten\",\"stale\",\"expired\",\"expire\",\"spoiled\",\"damaged\",\"bad quality\",\"poor quality\",\"fresh\",\"freshness\",\"condition\"],\n  wrong_item:    [\"wrong item\",\"wrong product\",\"different product\",\"not delivered\",\"missing\",\"half empty\",\"khali\",\"galat\"],\n  delivery:      [\"late delivery\",\"delayed\",\"slow delivery\",\"bad delivery\",\"rider\",\"delivery time\"],\n  support:       [\"customer service\",\"customer care\",\"no response\",\"complaint\"]\n};\n\nreturn $input.all().map(item => {\n  const text = (item.json.text || \"\").toLowerCase();\n  const tags = [];\n  for (const [tag, words] of Object.entries(groups)) {\n    if (words.some(w => text.includes(w))) tags.push(tag);\n  }\n  return { json: { ...item.json, category_tags: tags.join(\", \") || \"untagged\" } };\n});"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[1184,-32],"id":"a6ed08cf-9f3a-4abc-96d8-4251fe698b94","name":"category_tags"}],"connections":{"When clicking ‘Execute workflow’":{"main":[[{"node":"YT Search","type":"main","index":0},{"node":"YT Search - instamart","type":"main","index":0},{"node":"YT Search - quickcommerce","type":"main","index":0},{"node":"Reddit","type":"main","index":0},{"node":"Play Store","type":"main","index":0},{"node":"App Store","type":"