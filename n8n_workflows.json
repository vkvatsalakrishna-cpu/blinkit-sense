pet?.topLevelComment?.snippet;\n    if (s && s.textDisplay && s.textDisplay.split(\" \").length >= 5) {\n      out.push({ json: {\n        source: \"youtube\",\n        date: s.publishedAt || \"\",\n        text: s.textDisplay.replace(/<[^>]*>/g, \"\"),\n        rating: null,\n        url: \"https://www.youtube.com/watch?v=\" + (s.videoId || \"\")\n      }});\n    }\n  }\n}\nreturn out;"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[816,144],"id":"1db498ed-ae77-4396-8865-10ccbc2259e6","name":"Code in JavaScript3"},{"parameters":{"url":"=https://www.googleapis.com/youtube/v3/commentThreads?part=snippet&videoId={{ $json.id.videoId }}&maxResults=100&key=REDACTED","options":{}},"type":"n8n-nodes-base.httpRequest","typeVersion":4.4,"position":[656,144],"id":"720c9d08-9ad6-403e-9d58-e1557fcc9505","name":"CommentThreads","onError":"continueRegularOutput"},{"parameters":{"numberInputs":4},"type":"n8n-nodes-base.merge","typeVersion":3.2,"position":[992,-64],"id":"ea242ea1-e202-4e4f-8da3-88f303fff07b","name":"Merge"},{"parameters":{"operation":"append","documentId":{"__rl":true,"value":"1r8K7ZHEIySSRwcTWrZap8d3NFq3cIXklevojfoocBt4","mode":"list","cachedResultName":"blinkit-voc","cachedResultUrl":"https://docs.google.com/spreadsheets/d/1r8K7ZHEIySSRwcTWrZap8d3NFq3cIXklevojfoocBt4/edit?usp=drivesdk"},"sheetName":{"__rl":true,"value":"gid=0","mode":"list","cachedResultName":"data","cachedResultUrl":"https://docs.google.com/spreadsheets/d/1r8K7ZHEIySSRwcTWrZap8d3NFq3cIXklevojfoocBt4/edit#gid=0"},"columns":{"mappingMode":"defineBelow","value":{"source":"={{ $json.source }}","date":"={{ $json.date }}","text":"={{ $json.text }}","rating":"={{ $json.rating }}","url":"={{ $json.url }}","fetched_on":"={{ $now }}","category_tags":"={{ $json.category_tags }}"},"matchingColumns":[],"schema":[{"id":"source","displayName":"source","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":true,"removed":false},{"id":"date","displayName":"date","requi